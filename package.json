{
  "name": "dueloro-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:api": "tsc --ignoreConfig api/waitlist.ts --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck",
