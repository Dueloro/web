  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@react-three/fiber": "^9.6.1",
    "@shadergradient/react": "^2.4.20",
    "@vercel/functions": "^3.11.0",
    "camera-controls": "^3.1.2",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
